# ===== Flask =====
SECRET_KEY=change-me
PORT=5000
# 允许跨域的前端地址（前端跑在 8123）；多个用逗号分隔，* 表示全部
CORS_ORIGINS=http://127.0.0.1:8123

# ===== 数据库 =====
# 默认 SQLite，无需修改即可运行；生产可改为 PostgreSQL：
# DB_URL=postgresql+psycopg://user:pass@localhost:5432/ailms
DB_URL=sqlite:///./data/app.db

# ===== 大模型（对话 / 出题 / 批改）=====
# 兼容 OpenAI Chat Completions 格式；默认对接 DeepSeek
#   LLM_BASE_URL = https://api.deepseek.com/v1
#   LLM_MODEL    = deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
# 调用容错：网络异常/非200自动重试次数、单次超时（秒）
LLM_MAX_RETRIES=3
LLM_TIMEOUT=90

# ===== 向量模型（文本嵌入）=====
# 与上面的大模型独立配置，可来自不同服务商
# 默认阿里云百炼 OpenAI 兼容模式 + text-embedding-v4
EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ⚠️ 注意：这里是 EMB_API_KEY（不是 EMBED_API_KEY），config.py 按这个名字读取
EMB_API_KEY=sk-your-bailian-key
EMBED_MODEL=text-embedding-v4
# text-embedding-v4 用 1024；改这个值后需删除 data/chroma/ 重建向量库
EMBED_DIM=1024

# ===== 上传与处理 =====
# 单文件大小上限（MB），对应 PRD M-01
UPLOAD_MAX_MB=50
# 文本分块目标字数区间，对应 PRD M-03
CHUNK_MIN=500
CHUNK_MAX=800

# ===== 检索 =====
# 余弦相似度下限：低于此值的相关片段直接丢弃（避免答非所问）
RETRIEVE_MIN_SCORE=0.15
# 单次检索返回的最大片段数
RETRIEVE_TOP_K=8
